ADMINWEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=define_a_strong_password_here
ADMIN_ROLE=SuperAdmin
POSTGRES_DB=opencredential_admin
POSTGRES_USER=opencredential
POSTGRES_PASSWORD=define_a_strong_database_password_here

# Exact IP of your HTTPS reverse proxy, not the end user's IP.
ADMINWEB_TRUSTED_PROXY=
# Optional recovery email; use STARTTLS and deployment secrets.
RECOVERY_SMTP_ENABLED=false
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_SENDER=
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
