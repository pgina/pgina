    <Reference Include="Npgsql"><HintPath>..\..\Plugins\Core\bin\Npgsql.dll</HintPath></Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces"><HintPath>..\..\Plugins\Core\bin\Microsoft.Bcl.AsyncInterfaces.dll</HintPath></Reference>
    <Reference Include="System.Text.Json"><HintPath>..\..\Plugins\Core\bin\System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Text.Encodings.Web"><HintPath>..\..\Plugins\Core\bin\System.Text.Encodings.Web.dll</HintPath></Reference>
    <Reference Include="System.Data.SQLite"><HintPath>..\..\Plugins\Core\bin\System.Data.SQLite.dll</HintPath></Reference>
    <Reference Include="OpenCredential.Shared"><HintPath>..\..\Plugins\SDK\OpenCredential.Shared.dll</HintPath></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Plugins\Core\DatabaseLogger\DatabaseLogger\OfflineLogQueue.cs"><Link>OfflineLogQueue.cs</Link></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
